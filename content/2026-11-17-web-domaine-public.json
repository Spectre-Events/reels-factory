  "facts": [
    {
      "claim": "Fin 1990 : le premier serveur web (et le premier site) fonctionne au CERN, sur un ordinateur NeXT ; c'est alors le seul serveur web au monde",
      "sources": [
        "cern-histoire",
        "w3c",
        "sciencemuseum"
      ]
    },
    {
      "claim": "Étiquette manuscrite collée sur la machine : « This machine is a server. DO NOT POWER IT DOWN!! »",
      "sources": [
        "cern-histoire",
        "sciencemuseum"
      ]
    },
    {
      "claim": "Le CERN est installé à Genève",
      "sources": [
        "britannica",
        "cern-naissance"
      ]
    },
    {
      "claim": "Tim Berners-Lee rédige sa proposition en mars 1989, pour que les chercheurs partagent leurs informations",
      "sources": [
        "cern-histoire",
        "sciencemuseum",
        "britannica"
      ]
    },
    {
      "claim": "Janvier 1993 : environ 50 serveurs HTTP connus",
      "sources": [
        "w3c",
        "slac"
      ]
    },
    {
      "claim": "30 avril 1993 : le CERN place le logiciel du web dans le domaine public et renonce à ses droits de propriété intellectuelle ; chacun peut l'utiliser sans rien payer",
      "sources": [
        "cern-30ans",
        "cern-naissance",
        "w3c",
        "npr"
      ]
    },
    {
      "claim": "Fin 1993 : plus de 500 serveurs selon le CERN, 623 sites relevés en décembre 1993 par le MIT (d'où « plus de 600 »)",
      "sources": [
        "cern-histoire",
        "mit",
        "rfc2235"
      ]
    },
    {
      "claim": "Fin 1994 : 10 000 serveurs selon le CERN, 10 022 sites relevés en décembre 1994 par le MIT",
      "sources": [
        "cern-histoire",
        "mit",
        "rfc2235"
      ]
    },
    {
      "claim": "Calcul affiché : 10 022 / 623 = 16,1, soit seize fois plus en un an",
      "sources": [
        "mit",
        "rfc2235"
      ]
    },
    {
      "claim": "La mise à disposition gratuite du web est ce qui lui a permis de se répandre",
      "sources": [
        "cern-30ans",
        "npr"
      ]
    }
  ],
